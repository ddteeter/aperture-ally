# Copy to backend/.env. Values here are read by the backend only; never by the browser.
# Unset = safe mock defaults (no paid calls, no microphone, simulated speech).

# --- Model providers ---------------------------------------------------------------------------
# Choose default provider for new sessions: mock | openai | gemini
PHOTO_COACH_ASSESS_PROVIDER=mock
# Keys (or export them in your shell / load from the macOS keychain, see docs/setup.md)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Model IDs: copy CURRENT vision-capable model identifiers from the providers' official docs.
# They are deliberately not defaulted (docs/setup.md#models).
# PHOTO_COACH_OPENAI_MODEL=
# PHOTO_COACH_GEMINI_MODEL=
# PHOTO_COACH_OPENAI_IMAGE_DETAIL=high          # low | high | auto | original
# PHOTO_COACH_GEMINI_MEDIA_RESOLUTION=high      # low | medium | high
# Optional price table (USD per 1M tokens) from official pricing pages, for cost estimates:
# PHOTO_COACH_PRICES='{"<resolved-model-id>": {"input_per_mtok": 0, "output_per_mtok": 0, "verified_on": "YYYY-MM-DD", "source_url": "..."}}'

# --- Speech output ---------------------------------------------------------------------------
PHOTO_COACH_SPEECH_PROVIDER=say                 # say (macOS) | mock | none
# PHOTO_COACH_SAY_VOICE=Samantha
# PHOTO_COACH_SAY_RATE_WPM=190
# PHOTO_COACH_SAY_AUDIO_DEVICE=                 # name/ID from `say -a '?'`; empty = system output

# --- Voice input -----------------------------------------------------------------------------
PHOTO_COACH_RECORDER=sounddevice                # sounddevice | mock
# PHOTO_COACH_INPUT_DEVICE=                     # name/index from `photo-coach doctor`; empty = default
PHOTO_COACH_TRANSCRIBER=mock                    # openai | mock
# PHOTO_COACH_TRANSCRIPTION_MODEL=              # from official speech-to-text docs
# PHOTO_COACH_KEEP_VOICE_AUDIO=false

# --- Push-to-talk ----------------------------------------------------------------------------
PHOTO_COACH_GLOBAL_KEYS=none                    # pynput (macOS; needs Input Monitoring) | none
PHOTO_COACH_PTT_KEY=f18                         # e.g. f18, page_down, ctrl+f13 — find yours with Diagnostics → Learn key
PHOTO_COACH_PTT_MODE=hold                       # hold | toggle (for remotes that send single pulses)
# PHOTO_COACH_CANCEL_KEY=escape
PHOTO_COACH_PTT_MAX_SECONDS=60

# --- Storage ---------------------------------------------------------------------------------
# PHOTO_COACH_DATA_DIR=~/PhotoCoach
# PHOTO_COACH_IMPORT_ROOTS='["~/Pictures", "/Volumes/SD_CARD"]'
