# Copy to backend/.env. Values here are read by the backend only; never by the browser.
# Unset = safe mock defaults (no paid calls, no microphone, simulated speech).

# --- Model providers ---------------------------------------------------------------------------
# Choose default provider for new sessions: mock | openai | gemini | claude
APERTURE_ALLY_ASSESS_PROVIDER=mock
# Keys (or export them in your shell / load from the macOS keychain, see docs/setup.md)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=                          # or `ant auth login` (the Anthropic SDK resolves it)
# Model IDs: copy CURRENT vision-capable model identifiers from the providers' official docs.
# They are deliberately not defaulted (docs/setup.md#models).
# APERTURE_ALLY_OPENAI_MODEL=
# APERTURE_ALLY_GEMINI_MODEL=
# APERTURE_ALLY_OPENAI_IMAGE_DETAIL=high          # low | high | auto | original
# APERTURE_ALLY_GEMINI_MEDIA_RESOLUTION=high      # low | medium | high
# Claude: default model claude-opus-5-5 (Anthropic's recommended starting model; checked 2026-09-27).
# Alternatives to evaluate: claude-sonnet-5 (cheaper), claude-opus-5 (previous default).
# APERTURE_ALLY_CLAUDE_MODEL=claude-opus-5-5
# APERTURE_ALLY_CLAUDE_EFFORT=                  # low | medium | high | xhigh | max; empty = API default (medium on opus-5-5)
# APERTURE_ALLY_CLAUDE_REFUSAL_FALLBACK=true    # server-side fallback on safety declines; serving model is recorded
# Adaptive thinking can take longer than other providers; raise if you see timeouts:
# APERTURE_ALLY_MODEL_TIMEOUT_S=45
# Optional price table (USD per 1M tokens) from official pricing pages, for cost estimates:
# APERTURE_ALLY_PRICES='{"<resolved-model-id>": {"input_per_mtok": 0, "output_per_mtok": 0, "verified_on": "YYYY-MM-DD", "source_url": "..."}}'

# --- Speech output ---------------------------------------------------------------------------
APERTURE_ALLY_SPEECH_PROVIDER=say                 # say (macOS) | mock | none
# APERTURE_ALLY_SAY_VOICE=Samantha
# APERTURE_ALLY_SAY_RATE_WPM=190
# APERTURE_ALLY_SAY_AUDIO_DEVICE=                 # name/ID from `say -a '?'`; empty = system output

# --- Voice input -----------------------------------------------------------------------------
APERTURE_ALLY_RECORDER=sounddevice                # sounddevice | mock
# APERTURE_ALLY_INPUT_DEVICE=                     # name/index from `aperture-ally doctor`; empty = default
APERTURE_ALLY_TRANSCRIBER=mock                    # openai | mock
# APERTURE_ALLY_TRANSCRIPTION_MODEL=              # from official speech-to-text docs
# APERTURE_ALLY_KEEP_VOICE_AUDIO=false

# --- At the camera ------------------------------------------------------------------------------
# Audible "photo received" confirmation: sound (mixes with speech) | speech ("Got 12") | none
# APERTURE_ALLY_RECEIVED_CUE=sound
# Per-session caps on paid coaching/answer calls (transcription never blocked). USD cap needs PRICES.
# APERTURE_ALLY_SESSION_MAX_MODEL_CALLS=150
# APERTURE_ALLY_SESSION_BUDGET_USD=
# Optional second remote button that pauses/resumes auto-coaching
# APERTURE_ALLY_PAUSE_KEY=

# --- Push-to-talk ----------------------------------------------------------------------------
APERTURE_ALLY_GLOBAL_KEYS=none                    # pynput (macOS; needs Input Monitoring) | none
APERTURE_ALLY_PTT_KEY=f18                         # e.g. f18, page_down, ctrl+f13 — find yours with Diagnostics → Learn key
APERTURE_ALLY_PTT_MODE=hold                       # hold | toggle (for remotes that send single pulses)
# APERTURE_ALLY_CANCEL_KEY=escape
APERTURE_ALLY_PTT_MAX_SECONDS=60

# --- Telemetry (local only; git-ignored data dir) --------------------------------------------
# Full request context + raw model output for every call (needed to debug/tune prompts). Contains shoot notes.
# APERTURE_ALLY_STORE_MODEL_IO=true
# DNS/TCP probe of configured provider hosts every N seconds (and after failures); 0 = off
# APERTURE_ALLY_NETWORK_PROBE_INTERVAL_S=300
# Rotating log at <data dir>/logs/aperture-ally.log
# APERTURE_ALLY_LOG_TO_FILE=true

# --- Storage ---------------------------------------------------------------------------------
# APERTURE_ALLY_DATA_DIR=~/ApertureAlly
# APERTURE_ALLY_IMPORT_ROOTS='["~/Pictures", "/Volumes/SD_CARD"]'
